{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist-server",
    "isolatedModules": false,
    "allowImportingTsExtensions": false,
    "module": "ESNext",
    "target": "ES2022"
  },
  "include": [
    "server.ts",
    "src/server/**/*",
    "src/utils/**/*",
    "src/firebase.ts"
  ]
}
