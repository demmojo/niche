# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyB4SCHHPw2v2di_CS8u_yKaCz86j3kT3Ow"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APOLLO_API_KEY: Required for Apollo.io organization enrichment.
# Get this from your Apollo.io developer settings.
APOLLO_API_KEY="5TFrW_yDgwA_jFEItbjVrg"

# ---------------------------------------------------------
# Local Development Sandbox Overrides
# ---------------------------------------------------------

# SIMULATE_CLOUD_TASKS: Set to true to use the local setTimeout/fetch simulator
# instead of hitting the real Google Cloud Tasks API.
SIMULATE_CLOUD_TASKS=true

# VITE_USE_FIREBASE_EMULATOR: Set to true to connect the frontend and backend 
# to the local Firebase Emulator Suite (Firestore: 8080, Auth: 9099).
VITE_USE_FIREBASE_EMULATOR=true
